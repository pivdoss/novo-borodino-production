{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyEncryptedLeadBackupsIntoOnePrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET/novo-borodino/leads/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    }
  ]
}
