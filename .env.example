# Скопируйте файл в .env.local и заполните реальные значения.
# Никогда не публикуйте .env.local в GitHub.
SITE_URL=https://replace_with_real_domain.ru
SITE_ORIGIN=https://replace_with_real_domain.ru
# Add only after creating a separate Yandex Metrika counter for this real domain.
VITE_METRIKA_ID=
ADMIN_USERNAME=replace_with_admin_login
ADMIN_PASSWORD=replace_with_long_unique_password
ADMIN_SESSION_SECRET=replace_with_long_random_secret
ADMIN_ALLOWED_IPS=replace_with_trusted_admin_ip
REGISTRY_DB_PATH=/app/data/registry.sqlite
